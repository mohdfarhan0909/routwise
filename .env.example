# Routewise Gateway Configuration
# Copy this file to .env and fill in real values

# === App ===
APP_NAME=routewise
APP_ENV=development
DEBUG=true
LOG_LEVEL=info

# === Server ===
HOST=0.0.0.0
PORT=8000

# === PostgreSQL ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=routewise
POSTGRES_USER=routewise
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://routewise:changeme@postgres:5432/routewise

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# === Admin Authentication ===
ADMIN_SECRET_KEY=rw_admin_supersecret_key_change_in_production

# === Provider: OpenRouter ===
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === Provider: Google Gemini ===
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# === Provider: Groq ===
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# === Provider: Hugging Face ===
HF_API_KEY=
HF_BASE_URL=https://router.huggingface.co/v1

# === Provider: Mock (load testing) ===
MOCK_PROVIDER_URL=http://mock-provider:8001
# Set to true to use mock provider as final fallback when all real providers fail
# WARNING: Mock responses are not real LLM output. Only enable for testing/development.
ENABLE_MOCK_FALLBACK=false

# === Rate Limiting ===
DEFAULT_RPM_LIMIT=60
DEFAULT_DAILY_BUDGET=1.00

# === Gateway API Key (for rag-client and other first-party apps) ===
GATEWAY_API_KEY=rw_replace_with_real_key_from_admin_api

# === Semantic Cache ===
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_SECONDS=3600
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === Auth ===
API_KEY_PREFIX=rw_

# === Dashboard (CORS) ===
DASHBOARD_ORIGIN=http://localhost:3000
